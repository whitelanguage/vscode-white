{
  "name": "white-language-vscode",
  "displayName": "White Lang",
  "description": "VSCode Extension for White Language, powered by wlls.",
  "version": "0.0.2",
  "publisher": "whitelang-dev",
  "icon": "./resources/icon.png",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/whitelanguage/vscode-white.git"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "white",
    "whitelang",
    "whitelanguage",
    "wl"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:whitelang",
    "onCommand:whitelanguage.runFile"
  ],
  "contributes": {
    "commands": [
      {
        "command": "whitelanguage.runFile",
        "title": "Run White Language File",
        "category": "White Language",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "whitelanguage.runFile",
          "when": "editorLangId == whitelang",
          "group": "navigation@1"
        }
      ]
    },
    "languages": [
      {
        "id": "whitelang",
        "aliases": [
          "White Language",
          "WhiteLang"
        ],
        "extensions": [
          ".wl"
        ],
        "icon": {
          "light": "./resources/light.svg",
          "dark": "./resources/dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "whitelang",
        "scopeName": "source.whitelang",
        "path": "./syntaxes/whitelang.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "whitelang",
        "scopes": {
          "namespace": [
            "entity.name.namespace.whitelang"
          ],
          "namespace.defaultLibrary": [
            "entity.name.namespace.whitelang"
          ],
          "keyword": [
            "keyword.control.whitelang"
          ],
          "type": [
            "support.type.whitelang"
          ],
          "type.defaultLibrary": [
            "support.type.whitelang"
          ],
          "class": [
            "entity.name.type.class.whitelang"
          ],
          "class.defaultLibrary": [
            "entity.name.type.class.whitelang"
          ],
          "struct": [
            "entity.name.type.struct.whitelang"
          ],
          "struct.defaultLibrary": [
            "entity.name.type.struct.whitelang"
          ],
          "interface": [
            "entity.name.type.interface.whitelang"
          ],
          "interface.defaultLibrary": [
            "entity.name.type.interface.whitelang"
          ],
          "enum": [
            "entity.name.type.enum.whitelang"
          ],
          "enum.defaultLibrary": [
            "entity.name.type.enum.whitelang"
          ],
          "enumMember": [
            "constant.other.enum.whitelang"
          ],
          "enumMember.defaultLibrary": [
            "constant.other.enum.whitelang"
          ],
          "function": [
            "entity.name.function.whitelang"
          ],
          "function.defaultLibrary": [
            "entity.name.function.whitelang"
          ],
          "method": [
            "entity.name.function.member.whitelang"
          ],
          "method.defaultLibrary": [
            "entity.name.function.member.whitelang"
          ],
          "parameter": [
            "variable.parameter.whitelang"
          ],
          "parameter.defaultLibrary": [
            "variable.parameter.whitelang"
          ],
          "variable": [
            "variable.other.whitelang"
          ],
          "variable.readonly": [
            "variable.other.constant.whitelang"
          ],
          "variable.defaultLibrary": [
            "variable.other.whitelang"
          ],
          "variable.readonly.defaultLibrary": [
            "variable.other.constant.whitelang"
          ],
          "property": [
            "variable.other.property.whitelang"
          ],
          "property.readonly": [
            "variable.other.constant.property.whitelang"
          ],
          "property.defaultLibrary": [
            "variable.other.property.whitelang"
          ],
          "property.readonly.defaultLibrary": [
            "variable.other.constant.property.whitelang"
          ],
          "string": [
            "string.quoted.whitelang"
          ],
          "number": [
            "constant.numeric.whitelang"
          ],
          "comment": [
            "comment.whitelang"
          ],
          "operator": [
            "keyword.operator.whitelang"
          ],
          "decorator": [
            "entity.name.tag.annotation.whitelang"
          ],
          "decorator.defaultLibrary": [
            "entity.name.tag.annotation.whitelang"
          ],
          "annotation": [
            "entity.name.tag.annotation.whitelang"
          ]
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "annotation",
        "superType": "type",
        "description": "A White Language compiler annotation."
      }
    ],
    "configurationDefaults": {
      "[whitelang]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "configuration": {
      "title": "White Language",
      "properties": {
        "whitelanguage.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the wlls executable. When empty, the extension uses WL_PATH/bin/wlls."
        },
        "whitelanguage.server.trace": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Log wlls protocol traffic in the White Language output channel."
        },
        "whitelanguage.compiler.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Path to the wlc executable. When empty, the extension uses WL_PATH/bin/wlc."
        },
        "whitelanguage.diagnostics.mode": {
          "type": "string",
          "enum": [
            "workspace",
            "openFiles",
            "visitedFiles"
          ],
          "enumItemLabels": [
            "Workspace",
            "Open Files",
            "Visited Files"
          ],
          "enumDescriptions": [
            "Show every diagnostic reported by wlls. Unopened files require project indexing support from the server.",
            "Only diagnose open files and clear their diagnostics when they close.",
            "Diagnose files when they are opened and keep their diagnostics after they close."
          ],
          "default": "openFiles",
          "scope": "window",
          "description": "Controls which White Language files receive diagnostics."
        }
      }
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "compile": "tsc --noEmit -p . && node ./scripts/build.mjs",
    "check": "npm run compile && node --test ./test",
    "package": "npm run check && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.6.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  }
}
